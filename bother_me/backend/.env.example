# Copy to .env:  cp .env.example .env
# These are local-only Docker credentials, not real secrets.
DATABASE_URL=postgresql+psycopg://botherme:botherme@localhost:5433/botherme

# Public Firebase project ID (same as in bother_me/lib/firebase_options.dart)
FIREBASE_PROJECT_ID=botherme-1f44f

# LOCAL TESTING ONLY: lets you send "Bearer dev:<firebase_uid>" instead of a real
# Firebase token (e.g. dev:seed-alice). Never enable this on a deployed server.
DEV_AUTH=true
